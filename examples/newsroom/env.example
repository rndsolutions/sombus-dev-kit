# The live newsroom's settings. Copy to .env.newsroom (git ignores it), fill in, then:
#   set -a; source .env.newsroom; set +a; npm run newsroom
# A role runs when its PRODUCER_ID is set. Leave a role out to play it with your own system.

SOMBUS_BASE_URL=https://api.sombus.rnd-solutions.net/v1/
# SOMBUS_TOKEN_URL defaults to <SOMBUS_BASE_URL>oauth/token

# system_ids are <prefix>-<role> (acme-live-ncs, …): the ones your producer connections claimed.
SOMBUS_NEWSROOM_SYSTEM_PREFIX=acme-live

SOMBUS_NEWSROOM_NCS_PRODUCER_ID=
SOMBUS_NEWSROOM_NCS_PRODUCER_SECRET=
SOMBUS_NEWSROOM_NCS_CONSUMER_ID=
SOMBUS_NEWSROOM_NCS_CONSUMER_SECRET=

SOMBUS_NEWSROOM_MAM_PRODUCER_ID=
SOMBUS_NEWSROOM_MAM_PRODUCER_SECRET=
SOMBUS_NEWSROOM_MAM_CONSUMER_ID=
SOMBUS_NEWSROOM_MAM_CONSUMER_SECRET=

SOMBUS_NEWSROOM_SKILL_PRODUCER_ID=
SOMBUS_NEWSROOM_SKILL_PRODUCER_SECRET=
SOMBUS_NEWSROOM_SKILL_CONSUMER_ID=
SOMBUS_NEWSROOM_SKILL_CONSUMER_SECRET=

SOMBUS_NEWSROOM_GRAPHICS_PRODUCER_ID=
SOMBUS_NEWSROOM_GRAPHICS_PRODUCER_SECRET=
SOMBUS_NEWSROOM_GRAPHICS_CONSUMER_ID=
SOMBUS_NEWSROOM_GRAPHICS_CONSUMER_SECRET=

SOMBUS_NEWSROOM_STANDARDS_PRODUCER_ID=
SOMBUS_NEWSROOM_STANDARDS_PRODUCER_SECRET=
SOMBUS_NEWSROOM_STANDARDS_CONSUMER_ID=
SOMBUS_NEWSROOM_STANDARDS_CONSUMER_SECRET=

SOMBUS_NEWSROOM_PLAYOUT_PRODUCER_ID=
SOMBUS_NEWSROOM_PLAYOUT_PRODUCER_SECRET=
SOMBUS_NEWSROOM_PLAYOUT_CONSUMER_ID=
SOMBUS_NEWSROOM_PLAYOUT_CONSUMER_SECRET=

SOMBUS_NEWSROOM_CMS_PRODUCER_ID=
SOMBUS_NEWSROOM_CMS_PRODUCER_SECRET=
SOMBUS_NEWSROOM_CMS_CONSUMER_ID=
SOMBUS_NEWSROOM_CMS_CONSUMER_SECRET=

SOMBUS_NEWSROOM_AUTOMATION_PRODUCER_ID=
SOMBUS_NEWSROOM_AUTOMATION_PRODUCER_SECRET=
SOMBUS_NEWSROOM_AUTOMATION_CONSUMER_ID=
SOMBUS_NEWSROOM_AUTOMATION_CONSUMER_SECRET=

# Run only some roles in this process, e.g. one process per role.
# SOMBUS_NEWSROOM_ROLES=ncs,mam
# Play a whole day in about 12 minutes, from 06:00 (60x). Unset: the real clock.
# SOMBUS_NEWSROOM_SPEED=60
# Which day's stories (YYYY-MM-DD): pick another date for fresh stories. Default today.
# SOMBUS_NEWSROOM_DAY=
# Stop after this many minutes. Unset: run until Ctrl-C.
# SOMBUS_NEWSROOM_MINUTES=15
